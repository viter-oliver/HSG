  void bind_var_t<vec3>::edit(){
    string rg = get_rg(_var_name);
    if (rg == "clr") {
      string vname = get_show_name(_var_name);
      ImGui::ColorEdit3(vname.c_str(), (float *)&_value);
    } else {
      string fmt = "%.3f";
      string vname =_var_name;
      value_range range = f32_range;
      auto itb = value_range_table.find(rg);
      if (itb != value_range_table.end()) {
        range = itb->second;
        if (rg == "hac") {
          fmt = "%.6f";
        }
        vname = get_show_name(_var_name);
      } 
      ImGui::SliderFloat3(vname.c_str(), (float *)&_value, range._min._f,
                          range._max._f, fmt.c_str());
    }
  }

